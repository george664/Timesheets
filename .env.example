# Copy to .env.local and fill in.

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, "Web application").
# Enable the Google Calendar API for the project, and add this redirect URI:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts the session cookie. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=

# The URL the app is served from.
NEXTAUTH_URL=http://localhost:3000
